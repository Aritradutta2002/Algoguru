# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"

# ── App URL (optional: auth dynamically detects window.location.origin) ─────────
# In local dev, any port (3000, 8080, etc.) is automatically kept on localhost.
# In production, defaults to current host or https://algoguru.online.
NEXT_PUBLIC_PUBLIC_BASE_URL="http://localhost:3000"

# ── Payment / Support credentials ─────────────────────────────────────────────
NEXT_PUBLIC_UPI_ID="yourname@bankhandle"
NEXT_PUBLIC_RAZORPAY_URL="https://rzp.io/l/your_payment_link"
NEXT_PUBLIC_PAYPAL_URL="https://paypal.me/YourName"
NEXT_PUBLIC_BUYMEACOFFEE_URL="https://buymeacoffee.com/YourName"
NEXT_PUBLIC_CRYPTO_ADDRESS=""        # leave empty to hide the Crypto tab

# --- Contest module (optional) ------------------------------------------------
# Selects the coding-contest session backend. "remote" (default) calls the
# contest-coding Supabase edge function; "local" uses the browser-only
# development adapter, which is NOT authoritative and never runs hidden tests.
# Prefer leaving this unset and using the in-app "Continue in local practice
# mode" button, which requires an explicit opt-in.
NEXT_PUBLIC_CONTEST_SESSION_MODE="remote"

# Selects the coding-contest code-execution path.
#   "practice" (default) — compile and run against the problem's PUBLIC visible
#                          samples in the browser. Real execution, no score.
#   "server"             — the contest-execute edge function (falls back to
#                          practice until it is deployed).
#   "off"                — no execution; the console says so and offers Retry.
NEXT_PUBLIC_CONTEST_EXECUTION_MODE="practice"

# NOTE: code-execution provider settings (CODE_EXECUTION_PROVIDER,
# CODE_EXECUTION_BASE_URL, CODE_EXECUTION_API_KEY) are SERVER-SIDE secrets for
# the contest-execute function. They must never be given a NEXT_PUBLIC_ prefix.
