# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file to git.

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your_project_id"
VITE_SUPABASE_PUBLISHABLE_KEY="your_supabase_publishable_key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# ── App URL (optional: auth dynamically detects window.location.origin) ─────────
# In local dev, any port (8080, 8081, etc.) is automatically kept on localhost.
# In production, defaults to current host or https://algoguru.online.
VITE_PUBLIC_BASE_URL="http://localhost:8080"
# ── Payment / Support credentials ────────────────────────────────────────────
VITE_UPI_ID="yourname@bankhandle"
VITE_RAZORPAY_URL="https://rzp.io/l/your_payment_link"
VITE_PAYPAL_URL="https://paypal.me/YourName"
VITE_BUYMEACOFFEE_URL="https://buymeacoffee.com/YourName"
VITE_CRYPTO_ADDRESS=""        # leave empty to hide the Crypto tab

# --- Contest module (optional) ---------------------------------------------
# Selects the coding-contest session backend. "remote" (default) calls the
# contest-coding Supabase edge function; "local" uses the browser-only
# development adapter, which is NOT authoritative and never runs hidden tests.
# Prefer leaving this unset and using the in-app "Continue in local practice
# mode" button, which requires an explicit opt-in.
VITE_CONTEST_SESSION_MODE="remote"

# NOTE: code-execution provider settings (CODE_EXECUTION_PROVIDER,
# CODE_EXECUTION_BASE_URL, CODE_EXECUTION_API_KEY) are SERVER-SIDE secrets for
# the contest-execute function. They must never be given a VITE_ prefix.